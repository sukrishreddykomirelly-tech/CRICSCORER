modules = ["python-3.12", "web", "nodejs-20"]
run = "python app.py"

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[deployment]
run = ["bash", "-c", "python -c 'import database; database.init_db(); database.seed_db()' && exec gunicorn --bind 0.0.0.0:5000 --workers 1 app:app"]
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

