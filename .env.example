# =======================================================
# CricScorer Environment Configuration
# Copy this file to '.env' and fill in your actual values.
# The '.env' file is ignored by Git to keep your keys safe.
# =======================================================

# Groq API Key for AI Cricket Assistant
# Get yours from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Identifier (Default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Flask Secret Key
SECRET_KEY=cricscorer-super-secret-key-2026

# PostgreSQL Database URL (Optional: defaults to local SQLite if omitted)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/cricscorer

# Firebase Admin service-account JSON (store the real value in Replit Secrets)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
